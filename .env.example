APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

PYTHON_AI_SERVICE_TIMEOUT=3600
PYTHON_AI_SERVICE_URL=https://queue.fal.run
PYTHON_AI_IMAGE_GENERATION_ENDPOINT=/xai/grok-imagine-image
PYTHON_AI_AUTH_TOKEN=your_token_here

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# docker compose: optional services a plain `up` also starts (ai = renders/shorts).
# Blank it to run only the API. Others: voice, tools.
COMPOSE_PROFILES=ai

# Stripe (setup steps: config/stripe.php)
# Developers > API keys: secret key (sk_test_... until checkout is tested)
STRIPE_SECRET=
# Developers > Webhooks > your endpoint > Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Optional: where Checkout / the portal return to. Default FRONTEND_URL/dashboard/billing.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=

# Claude / MCP video studio (modules/Mcp, config/mcp.php). Users connect their
# own LLM at <MCP_PUBLIC_URL>/mcp with a key from the dashboard's Connect
# Claude page. Free: no LLM/image spend; renders are rate-limited.
MCP_ENABLED=true
# Public base URL clients connect to (default APP_URL). Must be https for claude.ai.
# MCP_PUBLIC_URL=https://api.example.com
# MCP_RENDERS_PER_DAY=5
# MCP_PREVIEWS_PER_HOUR=150
# MCP_MAX_VIDEO_SECONDS=900
# MCP_DEFAULT_FPS=60
# MCP_ALLOW_PAID_VOICES=false
# Studio renders run on their own queue + container (`mcp-worker`), never the
# paid `worker`. Optionally on their own render server too:
# MCP_QUEUE=mcp
# MCP_QUEUE_RETRY_AFTER=15000
# MCP_REMOTION_URL=http://host.docker.internal:3021
# MCP_REMOTION_ASSET_BASE_URL=http://localhost:3021
# Daily cleanup (scheduler container): presenter frame strips idle this many days.
# MCP_PRUNE_FRAMES_DAYS=7
